+/// Extract the raw JSON number literal that is the value of the top-level object
+/// key `key` from `meta_json`, returning the exact source token (e.g. `"1.0"`,
+/// `"1e0"`, `"1.0000000000000001"`).
+///
+/// We must read the EXACT literal because `serde_json` (no `arbitrary_precision`)
+/// has already lost sub-ULP precision in its parsed `f64`. This is a small,
+/// purpose-built scan over a tiny snapshot-meta blob: find the quoted key, skip
+/// whitespace and the `:`, then capture the number token
+/// `-?digits(.digits)?([eE][+-]?digits)?`. Returns `None` if the key or a number
+/// value cannot be located (the caller already proved via `serde_json` that the
+/// blob is valid JSON and the field is a `Number`).
+fn extract_raw_number_literal<'a>(meta_json: &'a [u8], key: &str) -> Option<&'a str> {
+    let text = std::str::from_utf8(meta_json).ok()?;
+    // Find `"key"` as a quoted object key. We look for the quoted form to avoid
+    // matching the substring inside another token; the value is the first number
+    // literal following the `:`.
+    let needle = format!("\"{key}\"");
+    let mut search_from = 0usize;
+    loop {
+        let rel = text[search_from..].find(&needle)?;
+        let key_start = search_from + rel;
+        let after_key = key_start + needle.len();
+        // Skip whitespace, require a ':'.
+        let bytes = text.as_bytes();
+        let mut i = after_key;
+        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        if i >= bytes.len() || bytes[i] != b':' {
+            // Not a key:value pair (e.g. the key appears as a value); keep searching.
+            search_from = after_key;
+            continue;
+        }
+        i += 1; // past ':'
+        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        // Capture a number literal: optional '-', digits, optional '.digits',
+        // optional exponent. If the value is not a number (string/null/etc.), bail
+        // — the caller already classified it as a Number, so this should not happen,
+        // but returning None makes the caller HARD-ERROR rather than guess.
+        let start = i;
+        if i < bytes.len() && bytes[i] == b'-' {
+            i += 1;
+        }
+        let num_start = i;
+        while i < bytes.len() && bytes[i].is_ascii_digit() {
+            i += 1;
+        }
+        if i < bytes.len() && bytes[i] == b'.' {
+            i += 1;
+            while i < bytes.len() && bytes[i].is_ascii_digit() {
+                i += 1;
+            }
+        }
+        if i < bytes.len() && (bytes[i] == b'e' || bytes[i] == b'E') {
+            i += 1;
+            if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {
+                i += 1;
+            }
+            while i < bytes.len() && bytes[i].is_ascii_digit() {
+                i += 1;
+            }
+        }
+        if i == num_start {
+            // No digits captured ⇒ the value was not a number token here.
+            return None;
+        }
+        return Some(&text[start..i]);
+    }
+}
