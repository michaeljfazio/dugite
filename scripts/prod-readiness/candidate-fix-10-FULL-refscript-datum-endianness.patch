+    // spent in newer snapshots, so they are verified *if present* but not
+    // required to be found. Either way, every found target is asserted byte-exact.
+    let targets: &[(&str, u16, &str, bool)] = &[
+        // Legacy verified fixtures (tag-5, txix 0) — may be spent in newer dumps.
+        (
