+/// Encode a u64 as a MemPack VarLen (7-bit, MSB-first base-128).
+fn encode_varlen(mut v: u64) -> Vec<u8> {
+    // Collect 7-bit groups, least-significant first, then reverse.
+    let mut groups = vec![(v & 0x7f) as u8];
+    v >>= 7;
+    while v > 0 {
+        groups.push((v & 0x7f) as u8);
+        v >>= 7;
+    }
+    groups.reverse();
+    let n = groups.len();
+    for (i, g) in groups.iter_mut().enumerate() {
+        if i + 1 < n {
+            *g |= 0x80; // continuation bit on all but the last
+        }
+    }
+    groups
+}
+
+/// Build a MemPack ShortByteString: VarLen(len) ‖ bytes.
+fn mempack_sbs(bytes: &[u8]) -> Vec<u8> {
+    let mut v = encode_varlen(bytes.len() as u64);
+    v.extend_from_slice(bytes);
+    v
+}
