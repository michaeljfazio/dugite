@@ -551,6 +551,14 @@ pub fn datums_to_plutus(
     // `Map.toList (unTxDats …)`. (V1 AssocList and V2 AssocMap both consume
     // this ordering.)
     out.sort_by_key(|(hash, _)| *hash);
+    // `TxDats = Map DataHash (Data era)` — keyed by datum hash, so duplicate
+    // witness datums (the same datum supplied more than once, e.g. when one
+    // input AND one output reference the same datum hash) collapse to a SINGLE
+    // entry. dugite stores the witness `plutus_data` as a `Vec`, so dedup by
+    // hash here to match `Map.toList (unTxDats …)` byte-exact. Cf. cardano-ledger
+    // `transTxWitsDatums = transDataPair <$> Map.toList (txWits ^. datsTxWitsL .
+    // unTxDatsL)` and `newtype TxDats era = … Map DataHash (Data era)`.
+    out.dedup_by_key(|(hash, _)| *hash);
     Ok(out)
 }
 
