+#[test]
+fn test_decode_tag5_datumhash_and_native_refscript() {
+    // tag-5 with a DatumHash option (32 bytes, stored big-endian directly) and a
+    // native (timelock) reference script. The native body is the raw CBOR of a
+    // single ScriptPubkey (timelock): [0, h28].
+    let datum_hash = [0xABu8; 32];
+    // Native script CBOR: array(2) [0, bytes(28)] — a ScriptPubkey timelock.
+    //   0x82 array(2), 0x00 uint 0 (ScriptPubkey), 0x58 28 bytes-header.
+    let mut native_cbor = vec![0x82, 0x00, 0x58, 28];
+    native_cbor.extend_from_slice(&[0xCD; 28]);
+
+    let mut val = Vec::new();
+    val.push(5);
+    val.push(29);
+    val.extend_from_slice(&[0x71; 29]);
+    val.push(0); // ADA-only
+    val.extend_from_slice(&encode_varlen(10));
+    // Datum option: DatumHash = tag 1 + 32 raw bytes.
+    val.push(1);
+    val.extend_from_slice(&datum_hash);
+    // Script: AlonzoScript::NativeScript = tag 0 + ShortByteString(native_cbor).
+    val.push(0);
+    val.extend_from_slice(&mempack_sbs(&native_cbor));
+
+    let (txout, consumed) = decode_mempack_txout(&val).unwrap();
+    assert_eq!(consumed, val.len());
+    assert_eq!(txout.tag, 5);
+    assert_eq!(txout.coin, 10);
+    assert_eq!(
+        txout.datum_hash,
+        Some(datum_hash),
+        "datum hash stored verbatim"
+    );
+
+    let blob = txout.script_ref.expect("script_ref");
+    match parse_script_ref_kind(&blob).expect("classify") {
+        ScriptRefKind::Native(cbor) => assert_eq!(cbor, native_cbor),
+        other => panic!("expected Native, got {other:?}"),
+    }
+}
