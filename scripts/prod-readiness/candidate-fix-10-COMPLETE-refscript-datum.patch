+#[test]
+fn test_decode_tag5_ada_only_plutus_v3_refscript() {
+    // Construct a synthetic tag-5 (TxOutCompactRefScript) entry, ADA-only, with
+    // a NoDatum option and a Conway-era PlutusV3 reference script, matching the
+    // cardano-ledger MemPack layout:
+    //   packTagM 5 >> packM cAddr >> packM cValue >> packM datum >> packM script
+    let flat_program = b"\x01\x00\x00\x20\xfe\xed"; // arbitrary flat-encoded bytes
+    let mut val = Vec::new();
+    val.push(5); // outer TxOut tag
+                 // CompactAddr: VarLen(29) + 29-byte enterprise script address.
+    val.push(29);
+    val.extend_from_slice(&[0x71; 29]);
+    // CompactValue ADA-only: tag(0) + VarLen(coin).
+    val.push(0);
+    val.extend_from_slice(&encode_varlen(2_000_000));
+    // Datum option: NoDatum = tag 0.
+    val.push(0);
+    // Script (AlonzoScript): tag 1 (Plutus) + era-relative lang tag 2 (Conway V3)
+    //   + ShortByteString(flat_program).
+    val.push(1); // AlonzoScript::PlutusScript
+    val.push(2); // ConwayPlutusV3
+    val.extend_from_slice(&mempack_sbs(flat_program));
+
+    let (txout, consumed) = decode_mempack_txout(&val).unwrap();
+    assert_eq!(consumed, val.len(), "tag-5 must consume the whole blob");
+    assert_eq!(txout.tag, 5);
+    assert_eq!(txout.coin, 2_000_000);
+    assert!(txout.datum_hash.is_none());
+    assert!(txout.datum.is_none());
+    assert!(txout.opaque_tail.is_none());
+
+    let blob = txout.script_ref.expect("script_ref must be populated");
+    let kind = parse_script_ref_kind(&blob).expect("classify");
+    match kind {
+        ScriptRefKind::Plutus { lang_tag, body } => {
+            assert_eq!(lang_tag, 2, "Conway era-relative V3 tag");
+            assert_eq!(body, flat_program, "flat program bytes recovered exactly");
+        }
+        other => panic!("expected Plutus, got {other:?}"),
+    }
+}
