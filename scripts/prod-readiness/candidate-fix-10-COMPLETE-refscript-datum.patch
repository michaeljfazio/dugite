+#[test]
+fn test_decode_tag4_ada_only_inline_datum_strips_varlen() {
+    // tag-4 (TxOutCompactDatum): CompactAddr + CompactValue + BinaryData.
+    //   packTagM 4 >> packM cAddr >> packM cValue >> packM datum
+    // The datum is a `BinaryData` (NOT a Datum option), serialized as a bare
+    // ShortByteString: VarLen(len) ‖ raw_cbor. The decoder MUST strip the VarLen
+    // prefix so `txout.datum` is the bare on-chain Plutus Data CBOR.
+    //
+    // Use a real-shape datum: d87a80 = CBOR tag(122) [] (an empty constructor),
+    // exactly the 3-byte body observed in the preprod blob.
+    let datum_cbor = [0xd8u8, 0x7a, 0x80];
+    let mut val = Vec::new();
+    val.push(4);
+    val.push(29);
+    val.extend_from_slice(&[0x71; 29]);
+    // CompactValue ADA-only: tag(0) + VarLen(coin).
+    val.push(0);
+    val.extend_from_slice(&encode_varlen(1_234_567));
+    // BinaryData: VarLen(3) ‖ datum_cbor.
+    val.extend_from_slice(&mempack_sbs(&datum_cbor));
+
+    let (txout, consumed) = decode_mempack_txout(&val).unwrap();
+    assert_eq!(consumed, val.len(), "tag-4 must consume the whole blob");
+    assert_eq!(txout.tag, 4);
+    assert_eq!(txout.coin, 1_234_567);
+    assert!(txout.datum_hash.is_none());
+    assert!(txout.script_ref.is_none());
+    assert!(txout.multi_asset.is_none());
+    assert_eq!(
+        txout.datum.as_deref(),
+        Some(&datum_cbor[..]),
+        "BinaryData VarLen prefix must be stripped; bare datum CBOR recovered"
+    );
+}
