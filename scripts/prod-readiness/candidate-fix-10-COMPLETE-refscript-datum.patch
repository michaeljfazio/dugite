+/// Byte-exact correctness oracle for **inline datums** against a REAL preprod
+/// `tables` MemPack blob (gap A of #10).
+///
+/// Asserts that the decoded `Datum`/`BinaryData` CBOR for known tag-4
+/// (`TxOutCompactDatum`) outputs blake2b-256-hashes to the on-chain datum hash
+/// recorded by the chain (cross-checked against preprod Koios `tx_info`). This is
+/// the chain-critical proof that the MemPack `BinaryData` `VarLen` length prefix
+/// is stripped byte-exact: a wrong inline datum builds a wrong `ScriptContext`
+/// and produces spurious phase-2 "script returned Error term" failures at the
+/// live tip.
+///
+/// The datum hashes are NOT `txout.datum_hash` (tag 4 carries no hash field);
+/// they are the values returned by `cardano-cli`/Koios for these exact outputs,
+/// i.e. an independent oracle of the original on-chain Plutus `Data` bytes.
+#[test]
+fn test_real_preprod_inline_datum_bytes() {
+    let Ok(path) = std::env::var("DUGITE_PREPROD_TABLES") else {
+        eprintln!("skipping: set DUGITE_PREPROD_TABLES to a real tables/tvar blob");
+        return;
+    };
+    let data = std::fs::read(&path).expect("read tables blob");
+    // (full_txid_hex, mempack_txix, expected blake2b-256 of the inline datum).
+    // Oracle: preprod Koios tx_info datum_hash for these outputs of tx
+    // 0001459f… (idx0 → aafa39eb…, idx1/mempack-256 → 54cfb9d3…).
+    let targets: &[(&str, u16, &str)] = &[
+        (
+            "0001459f22668acbc6955e38b3c312e7992bedc97c72769cd0a445f7698a7778",
+            0,
+            "aafa39ebc25447a60777ce2a7fd05fada3a05b2f2c04a2061d72fd2ba4a6e2c7",
+        ),
+        (
+            "0001459f22668acbc6955e38b3c312e7992bedc97c72769cd0a445f7698a7778",
+            256,
+            "54cfb9d3d091ecf4430e0f60c93bc41477b125a28068fec8fda80f50d16aaa51",
+        ),
+    ];
+    let mut matched = 0;
+    for entry in TvarIterator::new(&data).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (want_txid, want_ix, want_hash) in targets {
+            if &txid_hex != want_txid || txin.txix != *want_ix {
+                continue;
+            }
+            let datum = txout
+                .datum
+                .as_deref()
+                .expect("fixture UTxO must carry an inline datum");
+            // The decoded bytes must be the BARE on-chain Plutus Data CBOR
+            // (VarLen prefix stripped) so the datum hash matches the chain.
+            let got = hex::encode(dugite_primitives::hash::blake2b_256(datum).as_bytes());
+            assert_eq!(
+                &got, want_hash,
+                "inline-datum byte-exactness failed for {want_txid}#{want_ix}"
+            );
+            matched += 1;
+        }
+    }
+    assert_eq!(
+        matched,
+        targets.len(),
+        "all fixture inline-datum UTxOs must be found and verified"
+    );
+}
