+#[test]
+fn test_encode_varlen_roundtrips_decode_varlen() {
+    for v in [
+        0u64,
+        1,
+        127,
+        128,
+        150,
+        300,
+        1_814_145,
+        u32::MAX as u64,
+        u64::MAX,
+    ] {
+        let enc = encode_varlen(v);
+        let (dec, n) = decode_varlen(&enc).unwrap();
+        assert_eq!(dec, v, "roundtrip value");
+        assert_eq!(n, enc.len(), "consumed all bytes for {v}");
+    }
+}
