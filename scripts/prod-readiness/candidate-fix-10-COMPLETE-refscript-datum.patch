+/// Byte-exact correctness oracle against a REAL preprod `tables` MemPack blob.
+///
+/// Gated behind `DUGITE_PREPROD_TABLES` (path to a Haskell `tables`/`tvar` blob)
+/// because the multi-hundred-MB snapshot is not checked in. Asserts the decoded
+/// reference-script CIP-tagged blake2b-224 hashes for known preprod UTxOs match
+/// the values observed on the real chain — this is the chain-critical proof that
+/// the MemPack reference-script decode is byte-exact (green tests on synthetic
+/// data are NOT sufficient).
+///
+/// The second group (`7afbde08…`, `23d3717e…`, `bb4e5521…`, `86820a34…`) are the
+/// four residual "script not found for redeemer purpose" scripts from the #10
+/// verification re-soak. They live on tag-5 (`TxOutCompactRefScript`)
+/// **multi-asset** outputs at high indices; this oracle confirms the
+/// `decode_compact_value_exact` multi-asset branch lands on the Datum + Script
+/// tail so the script is recovered and hashes byte-exact.
+#[test]
+fn test_real_preprod_refscript_hashes() {
+    let Ok(path) = std::env::var("DUGITE_PREPROD_TABLES") else {
+        eprintln!("skipping: set DUGITE_PREPROD_TABLES to a real tables/tvar blob");
+        return;
+    };
+    let data = std::fs::read(&path).expect("read tables blob");
+    // (txid_prefix_hex, mempack_txix, expected CIP-tagged blake2b-224 hash, required).
+    //
+    // `required` targets MUST be present in the snapshot (the #10 gap-B residual
+    // scripts, live in the captured epoch). The legacy fixtures may have been
+    // spent in newer snapshots, so they are verified *if present* but not
+    // required to be found. Either way, every found target is asserted byte-exact.
+    let targets: &[(&str, u16, &str, bool)] = &[
+        // Legacy verified fixtures (tag-5, txix 0) — may be spent in newer dumps.
+        (
+            "f08f73509b0d3b4a",
+            0,
+            "744837b0a352566983276e1fb256e428d96eab87cc42972261e0c88b",
+            false,
+        ),
+        (
+            "e2766b4eb2b8d4da",
+            0,
+            "d55eb689d83301fb3797720278404adae39501cb8dbafa4da7bd9f3b",
+            false,
+        ),
+        // #10 gap-B residual scripts (tag-5 multi-asset, high txix). Matched by
+        // full txid AND mempack-txix because these txs have many outputs.
+        (
+            "dca0e8d51c6453bb16d303e5e3a3a2eede8a7cdf5c63bd4e52bfe1f9575fcdd4",
+            512,
+            "7afbde082796cfa6ed6ba87728c57f111815340af03e1897094163b3",
+            true,
+        ),
+        (
+            "354e08ab4979b74b650c3b5ff20c9847fa3d13cfdecc9e9c1c7d63d46ad9e3f0",
+            1024,
+            "23d3717e95f5ced3689a22cf2c8297e92505813264ee36fe8f6f4fc1",
+            true,
+        ),
+        (
+            "b1c7c9fa088686ab45563149f8a59c9b0cb8494c120462de60b905bfcc7460e6",
+            512,
+            "bb4e5521a62840eed81c2da2d3394b8cb6a7c6a99ecb95ffc9e498a7",
+            true,
+        ),
+        (
+            "95117915c169e8106ac3f1c8ba0c690882ec9034208de253d7fc247618199548",
+            256,
+            "86820a349e45e1a38a7e18750377393c6c2a4635964142db074ea250",
+            true,
+        ),
+    ];
+    let mut found = vec![false; targets.len()];
+    let mut without_script = 0u64;
+    for entry in TvarIterator::new(&data).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        // Defensive: after the #10 fix every tag-5 output must carry a script.
+        if txout.tag == 5 && txout.script_ref.is_none() {
+            without_script += 1;
+        }
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (i, (want_txid_prefix, want_ix, want_hash, _required)) in targets.iter().enumerate() {
+            if !txid_hex.starts_with(want_txid_prefix) || txin.txix != *want_ix {
+                continue;
+            }
+            let blob = txout
+                .script_ref
+                .as_deref()
+                .expect("fixture UTxO must carry a reference script");
+            let kind = parse_script_ref_kind(blob).expect("classify");
+            // Build the CIP-tagged preimage exactly as the ledger's
+            // compute_script_ref_hash does (Plutus: (lang_tag+1) ‖ body).
+            let tagged: Vec<u8> = match &kind {
+                ScriptRefKind::Native(cbor) => {
+                    let mut v = vec![0x00];
+                    v.extend_from_slice(cbor);
+                    v
+                }
+                ScriptRefKind::Plutus { lang_tag, body } => {
+                    let mut v = vec![lang_tag + 1];
+                    v.extend_from_slice(body);
+                    v
+                }
+            };
+            let got = hex::encode(dugite_primitives::hash::blake2b_224(&tagged).as_bytes());
+            assert_eq!(&got, want_hash, "CIP hash mismatch for {want_txid_prefix}");
+            found[i] = true;
+        }
+    }
+    assert_eq!(
+        without_script, 0,
+        "every tag-5 (TxOutCompactRefScript) output must decode a reference script"
+    );
+    for (i, (prefix, _ix, _hash, required)) in targets.iter().enumerate() {
+        if *required {
+            assert!(
+                found[i],
+                "required #10 gap-B fixture {prefix} not found in snapshot"
+            );
+        }
+    }
+}
