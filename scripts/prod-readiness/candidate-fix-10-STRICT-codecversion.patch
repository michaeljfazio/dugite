+/// End-to-end **key-correctness** oracle against a REAL preprod `tables` MemPack
+/// blob (gated on `DUGITE_PREPROD_TABLES`). The #10 proof that green synthetic
+/// unit tests are NOT sufficient: it derives the byte order AUTHORITATIVELY from
+/// the sibling `meta` file's `tablesCodecVersion` (the real preprod meta is
+/// version 1 => big-endian), confirms the data does NOT contradict it
+/// (cross-validation), and asserts that a known index-1 UTxO decodes to
+/// `txix == 1` (NOT 256) with the coin value Koios reports.
+///
+/// It also confirms the whole-blob TxIx distribution passes the safety net, and
+/// that index 1 vastly outnumbers index 256 (the inverse holds under a mis-key).
+///
+/// Targets (preprod Koios cross-checked):
+///   * 00000c0c…#1  → coin 1_750_000  (the canonical #10 fixture)
+#[test]
+fn test_real_preprod_txix_key_correctness() {
+    let Ok(path) = std::env::var("DUGITE_PREPROD_TABLES") else {
+        eprintln!("skipping: set DUGITE_PREPROD_TABLES to a real tables/tvar blob");
+        return;
+    };
+    let data = std::fs::read(&path).expect("read tables blob");
+
+    // AUTHORITATIVE endianness from the sibling `meta` file's tablesCodecVersion
+    // (real preprod BE snapshot => version 1 => Big). This mirrors the production
+    // importer's decision-maker. The empirical detector is used ONLY to
+    // cross-validate (it must NOT contradict the version).
+    let meta_path = std::path::Path::new(&path)
+        .parent()
+        .expect("tables blob has a parent dir")
+        .join("meta");
+    // STRICT #10: the real preprod snapshot is modern (meta present, backend
+    // "utxohd-mem", tablesCodecVersion=1 => Big). The meta is MANDATORY — there
+    // is no empirical-detector fallback in the production import path.
+    let meta = std::fs::read(&meta_path)
+        .expect("real preprod snapshot must have a meta file (strict: no meta-less import path)");
+    enforce_snapshot_backend_is_utxohd_mem(&meta).expect("real preprod backend must be utxohd-mem");
+    let version = parse_tables_codec_version(&meta).expect("parse meta tablesCodecVersion");
+    eprintln!("meta tablesCodecVersion: {version}");
+    // The real preprod BE snapshot must report codec version 1.
+    assert_eq!(version, 1, "real preprod meta must be tablesCodecVersion=1");
+    let endianness = TxIxEndianness::from_tables_codec_version(Some(version))
+        .expect("map version to endianness");
+    assert_eq!(
+        endianness,
+        TxIxEndianness::Big,
+        "version 1 => big-endian txix"
+    );
+    cross_validate_txix_endianness(&data, endianness)
+        .expect("data must not contradict meta version");
+    eprintln!("authoritative TxIx endianness: {endianness:?}");
+
+    // (full_txid_hex, expected real index, expected coin).
+    let targets: &[(&str, u16, u64)] = &[(
+        "00000c0cf6fe6389492dd7fe7c8ff3040d70d11b3356093cf651ac876c6f66d9",
+        1,
+        1_750_000,
+    )];
+    let mut found = vec![false; targets.len()];
+
+    let mut count_idx1 = 0u64;
+    let mut count_idx256 = 0u64;
+    let mut dist = TxIxDistribution::default();
+    for entry in TvarIterator::new_with_endianness(&data, endianness).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        observe_into(&mut dist, txin.txix);
+        if txin.txix == 1 {
+            count_idx1 += 1;
+        }
+        if txin.txix == 256 {
+            count_idx256 += 1;
+        }
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (i, (want_txid, want_ix, want_coin)) in targets.iter().enumerate() {
+            if &txid_hex != want_txid || txin.txix != *want_ix {
+                continue;
+            }
+            assert_eq!(
+                txout.coin, *want_coin,
+                "coin mismatch for {want_txid}#{want_ix} (key correctly resolved to real index)"
+            );
+            found[i] = true;
+        }
+    }
+    for (i, (txid, ix, _)) in targets.iter().enumerate() {
+        assert!(
+            found[i],
+            "required key-correctness fixture {txid}#{ix} not found"
+        );
+    }
+    // Hard safety net on the full distribution.
+    assert_txix_distribution_sane(&dist, endianness).expect("real snapshot distribution sane");
+    assert!(
+        count_idx1 > count_idx256 * 10,
+        "TxIx distribution looks mis-keyed: idx1={count_idx1} idx256={count_idx256}"
+    );
+}
