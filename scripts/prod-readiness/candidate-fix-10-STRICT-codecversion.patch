+                .multi_asset
+                .as_deref()
+                .expect("fixture UTxO must carry a multi-asset rep");
+            let triples = parse_multi_asset_rep(rep, txout.num_assets as usize)
+                .expect("rep must parse from the real blob");
+            assert!(
+                !triples.is_empty(),
+                "reconstructed multi_asset is EMPTY for {want_txid}#{want_ix} — \
+                 this is exactly the input_side:0 MultiAssetNotConserved symptom"
+            );
+            // Fold into a sorted (name -> qty) map and assert byte-exact equality
+            // with Koios's asset_list for this UTxO.
+            let policy_b = hex::decode(policy).unwrap();
+            let mut by_name: BTreeMap<String, u64> = BTreeMap::new();
+            for (pid, name, qty) in &triples {
+                assert_eq!(
+                    &pid[..],
+                    &policy_b[..],
+                    "all assets in {want_txid}#{want_ix} share the one policy"
+                );
+                *by_name
+                    .entry(String::from_utf8(name.clone()).unwrap())
+                    .or_default() += qty;
+            }
+            let got: Vec<String> = by_name.keys().cloned().collect();
+            let mut want: Vec<String> = want_names.iter().map(|s| s.to_string()).collect();
+            want.sort();
+            assert_eq!(
+                got, want,
+                "multi-asset reconstruction mismatch for {want_txid}#{want_ix}"
+            );
+            for n in *want_names {
+                assert_eq!(
+                    by_name.get(*n).copied(),
+                    Some(1),
+                    "quantity mismatch for {n} in {want_txid}#{want_ix}"
+                );
+            }
+            matched += 1;
+        }
+    }
+    assert_eq!(
+        matched,
+        targets.len(),
+        "all fixture multi-asset UTxOs must be found and verified"
+    );
+}
