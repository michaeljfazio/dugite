+            // decoder must recover the real numMA from the CompactValue header.
+            assert_eq!(
+                txout.num_assets, *want_numma,
+                "numMA not recovered for {want_txid}#{want_ix} (the #10 bug: opaque path \
+                 left num_assets=0 and dropped every asset)"
+            );
