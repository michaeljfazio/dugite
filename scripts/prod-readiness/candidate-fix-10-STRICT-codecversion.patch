+fn ada_only_txout(coin: u8) -> Vec<u8> {
+    let mut v = vec![0u8]; // tag 0
+    v.push(29); // CompactAddr VarLen len
+    v.extend_from_slice(&[0x60u8; 29]);
+    v.push(0); // CompactValue tag 0 (ADA-only)
+    v.push(coin); // VarLen(coin)
+    v
+}
