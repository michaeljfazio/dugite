+            0,
+            &[
+                "NFT_90", "NFT_91", "NFT_92", "NFT_93", "NFT_94", "NFT_95", "NFT_96", "NFT_97",
+                "NFT_98", "NFT_99",
+            ],
+            10,
+        ),
+        (
+            "00000c0cf6fe6389492dd7fe7c8ff3040d70d11b3356093cf651ac876c6f66d9",
+            1,
+            &[
+                "NFT_480", "NFT_481", "NFT_482", "NFT_483", "NFT_484", "NFT_485", "NFT_486",
+                "NFT_487", "NFT_488", "NFT_489",
+            ],
+            10,
+        ),
+    ];
+    let mut matched = 0;
+    for entry in TvarIterator::new(&data).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (want_txid, want_ix, want_names, want_numma) in targets {
+            if &txid_hex != want_txid || txin.txix != *want_ix {
+                continue;
+            }
