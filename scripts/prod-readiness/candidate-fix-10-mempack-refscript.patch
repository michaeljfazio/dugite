+/// Gated behind `DUGITE_PREPROD_TABLES` (path to a Haskell `tables`/`tvar` blob)
+/// because the multi-hundred-MB snapshot is not checked in. Asserts the decoded
+/// reference-script CIP-tagged blake2b-224 hashes for two known preprod UTxOs
+/// match the values observed on the real chain — this is the chain-critical
+/// proof that the MemPack reference-script decode is byte-exact (green tests on
+/// synthetic data are NOT sufficient).
+#[test]
+fn test_real_preprod_refscript_hashes() {
+    let Ok(path) = std::env::var("DUGITE_PREPROD_TABLES") else {
+        eprintln!("skipping: set DUGITE_PREPROD_TABLES to a real tables/tvar blob");
+        return;
+    };
+    let data = std::fs::read(&path).expect("read tables blob");
+    let targets: &[(&str, &str)] = &[
+        (
+            "f08f73509b0d3b4a",
+            "744837b0a352566983276e1fb256e428d96eab87cc42972261e0c88b",
+        ),
+        (
+            "e2766b4eb2b8d4da",
+            "d55eb689d83301fb3797720278404adae39501cb8dbafa4da7bd9f3b",
+        ),
+    ];
+    let mut matched = 0;
+    for entry in TvarIterator::new(&data).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        if txin.txix != 0 {
+            continue;
+        }
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (prefix, want_hash) in targets {
+            if !txid_hex.starts_with(prefix) {
+                continue;
+            }
+            let blob = txout
+                .script_ref
+                .as_deref()
+                .expect("fixture UTxO must carry a reference script");
+            let kind = parse_script_ref_kind(blob).expect("classify");
+            // Build the CIP-tagged preimage exactly as the ledger's
+            // compute_script_ref_hash does (Plutus: (lang_tag+1) ‖ body).
+            let tagged: Vec<u8> = match &kind {
+                ScriptRefKind::Native(cbor) => {
+                    let mut v = vec![0x00];
+                    v.extend_from_slice(cbor);
+                    v
+                }
+                ScriptRefKind::Plutus { lang_tag, body } => {
+                    let mut v = vec![lang_tag + 1];
+                    v.extend_from_slice(body);
+                    v
+                }
+            };
+            let got = hex::encode(dugite_primitives::hash::blake2b_224(&tagged).as_bytes());
+            assert_eq!(&got, want_hash, "CIP hash mismatch for {prefix}");
+            matched += 1;
+        }
+    }
+    assert_eq!(matched, 2, "both fixture UTxOs must be found and verified");
+}
