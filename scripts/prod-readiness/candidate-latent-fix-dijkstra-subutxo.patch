> // 0. InstantStake single-UTxO add / delete (Haskell addInstantStake / deleteInstantStake)
> // ============================================================================
> 
> /// Add a single produced output's coin to the incremental stake distribution.
> ///
> /// Mirrors Haskell `EraStake::addInstantStake`, documented as
> /// *"Add new UTxO to the InstantStake. This is invoked for every new TxOut that
> /// is added to the ledger state"*
> /// (`Cardano.Ledger.State.Stake`). The canonical UTXO rule applies it via
> /// `updateUTxOStateNoFees`:
> ///
> /// ```haskell
> /// utxosInstantStake =
> ///     deleteInstantStake deletedUTxO (addInstantStake utxoAdd (utxos ^. instantStakeL))
> /// ```
> ///
> /// Routing follows `stake_routing`: base/reward → `stake_map` (eager), pointer →
> /// `ptr_stake` (deferred), enterprise/Byron → no stake. Sharing this one helper
> /// across EVERY UTxO-producing path (top-level `apply_utxo_changes`, collateral
> /// return, and the Dijkstra SUBUTXO rule) is what guarantees the
> /// produce/consume symmetry the Haskell class enforces — any path that inserts a
> /// UTxO without calling this under-credits the credential's incremental stake.
> pub(crate) fn add_instant_stake(
>     output: &TransactionOutput,
>     certs: &mut CertSubState,
>     epochs: &mut EpochSubState,
> ) {
>     let coin = output.value.coin.0;
>     match stake_routing(&output.address, epochs.ptr_stake_excluded) {
>         StakeRouting::Credential(cred_hash) => {
>             *certs
>                 .stake_distribution
>                 .stake_map
>                 .entry(cred_hash)
>                 .or_insert(Lovelace(0)) += Lovelace(coin);
>         }
>         StakeRouting::Pointer(ptr) => {
>             *epochs.ptr_stake.entry(ptr).or_insert(0) += coin;
>         }
>         StakeRouting::None => {}
>     }
> }
> 
> /// Subtract a single consumed (spent) output's coin from the incremental stake
> /// distribution.
> ///
> /// Mirrors Haskell `EraStake::deleteInstantStake`, documented as
> /// *"Delete spent UTxO from the InstantStake. This is invoked for every TxOut
> /// that is removed from the ledger state"* (`Cardano.Ledger.State.Stake`).
> ///
> /// Uses `saturating_sub`: during a from-genesis replay an input may resolve to a
> /// credential whose tracked stake was not yet fully accumulated, and Haskell's
> /// `Map`-of-`CompactForm Coin` subtraction never goes negative in a well-formed
> /// chain. Callers are responsible for de-duplicating a `Set TxIn` so each spent
> /// UTxO is removed exactly once.
> pub(crate) fn delete_instant_stake(
>     spent_output: &TransactionOutput,
>     certs: &mut CertSubState,
>     epochs: &mut EpochSubState,
> ) {
>     let coin = spent_output.value.coin.0;
>     match stake_routing(&spent_output.address, epochs.ptr_stake_excluded) {
>         StakeRouting::Credential(cred_hash) => {
>             if let Some(stake) = certs.stake_distribution.stake_map.get_mut(&cred_hash) {
>                 stake.0 = stake.0.saturating_sub(coin);
>             }
>         }
>         StakeRouting::Pointer(ptr) => {
>             if let Some(entry) = epochs.ptr_stake.get_mut(&ptr) {
>                 *entry = entry.saturating_sub(coin);
>             }
>         }
>         StakeRouting::None => {}
>     }
> }
> 
