+/// Translate a primitive [`PrimPlutusData`] and attach the verbatim
+/// `raw_cbor` of the *whole* value as a memo, when available.
+///
+/// This is the entry point for **tx-originating** `Data` (datums,
+/// redeemers, inline datums, `txInfoData` entries): the memo makes a
+/// subsequent `serialiseData` / datum-hash return the *original* on-wire
+/// bytes rather than a canonical re-encode, mirroring the
+/// `MemoBytes`-backed `Cardano.Ledger.Plutus.Data.Data`. The memo lives
+/// only on the top-level node — sub-fields extracted by `unConstrData` /
+/// `unListData` / … are plain (canonical), matching whole-value
+/// `MemoBytes` memoisation.
+///
+/// `None` raw bytes (locally-constructed data, or a decoder that did not
+/// preserve the span) falls back to a memo-less value.
+pub fn plutus_data_to_data_memoised(p: &PrimPlutusData, raw_cbor: Option<&[u8]>) -> Data {
+    let data = plutus_data_to_data(p);
+    match raw_cbor {
+        Some(bytes) => data.with_original(std::rc::Rc::new(bytes.to_vec())),
+        None => data,
+    }
+}
