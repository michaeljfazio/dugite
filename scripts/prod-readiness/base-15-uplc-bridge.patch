+        // Canonical Constr 1: compact tag 122 = 0xd8 0x7a, then the
+        // (non-empty) indefinite field array.
+        assert_eq!(&out[..2], &[0xd8, 0x7a], "must use compact tag-121+ form");
+        assert_eq!(
+            out,
+            vec![0xd8, 0x7a, 0x9f, 0x43, 0x61, 0x62, 0x63, 0xff],
+            "machine-built Constr 1 [B abc] must be canonical"
+        );
+    }
+
+    /// The memo must be **invisible** to structural equality / hashing:
+    /// two structurally-equal `Data` values (one memoised, one not) must
+    /// be `==` and hash identically, so the CEK machine's `equalsData`,
+    /// env dedup and constant interning are unaffected.
+    #[test]
+    fn memo_is_ignored_by_eq_and_hash() {
+        use std::collections::hash_map::DefaultHasher;
+        use std::hash::{Hash, Hasher};
+
+        let memoised = Data::from_cbor(&[0xd8, 0x66, 0x82, 0x01, 0x80]).expect("decode");
+        let plain = Data::Constr(1, vec![]);
+        assert_eq!(memoised, plain, "memo must not affect equality");
+
+        let mut h1 = DefaultHasher::new();
+        let mut h2 = DefaultHasher::new();
+        memoised.hash(&mut h1);
+        plain.hash(&mut h2);
+        assert_eq!(h1.finish(), h2.finish(), "memo must not affect hashing");
+
+        // But their serialised forms differ (verbatim vs canonical).
+        assert_ne!(
+            memoised.to_cbor().unwrap(),
+            plain.to_cbor().unwrap(),
+            "verbatim memo vs canonical re-encode must serialise differently"
+        );
+    }
+
+    /// Sub-fields extracted from a memoised `Data` are themselves
+    /// memo-less (canonical) — matching `unConstrData` returning plain
+    /// `PV1.Data` fields. Only the *whole* tx-originating value carries
+    /// the `MemoBytes` original.
+    #[test]
+    fn extracted_subfields_are_memoless() {
+        // Constr 0 [ Constr 1 [] ] with the OUTER in non-canonical tag-102
+        // and the inner in compact form.
+        //   d8 66 82 00 9f  d87a80  ff
+        let bytes = vec![0xd8, 0x66, 0x82, 0x00, 0x9f, 0xd8, 0x7a, 0x80, 0xff];
+        let decoded = Data::from_cbor(&bytes).expect("decode");
+        assert!(decoded.original().is_some(), "top-level carries the memo");
+        let DataKind::Constr(0, fields) = &decoded.kind else {
+            panic!("expected Constr 0");
+        };
+        assert_eq!(fields.len(), 1);
+        assert!(
+            fields[0].original().is_none(),
+            "extracted sub-field must be memo-less (canonical), per MemoBytes whole-value memo"
+        );
+    }
 }
