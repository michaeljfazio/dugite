+/// Build a synthetic `array(1)[ map(indef) { … } ]` MemPack tables blob from
+/// `(txix_trailer_bytes, txout_value_blob)` pairs. The 32-byte TxId prefix is
+/// derived from the entry index so keys are distinct.
+fn build_tables_blob(entries: &[([u8; 2], Vec<u8>)]) -> Vec<u8> {
+    let mut out = vec![0x81u8, 0xbf]; // array(1), map(indef)
+    for (i, (trailer, val)) in entries.iter().enumerate() {
+        // CBOR bytes(34) key header: 0x58 0x22.
+        out.push(0x58);
+        out.push(34);
+        let mut key = [0u8; 34];
+        key[0] = i as u8;
+        key[1] = (i >> 8) as u8;
+        key[32] = trailer[0];
+        key[33] = trailer[1];
+        out.extend_from_slice(&key);
+        // CBOR bytes(N) value header.
+        if val.len() < 24 {
+            out.push(0x40 | val.len() as u8);
+        } else {
+            out.push(0x58);
+            out.push(val.len() as u8);
+        }
+        out.extend_from_slice(val);
+    }
+    out.push(0xff); // break
+    out
+}
