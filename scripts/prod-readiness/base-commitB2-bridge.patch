+/// Before the fix, tags 0/1 used the OPAQUE `decode_compact_value` path which left
+/// `num_assets = 0`, so `parse_multi_asset_rep(rep, 0)` returned an empty map and
+/// every native token was silently dropped on import. The imported UTxO carried
+/// ZERO of the asset that should be there, exactly reproducing the live phase-1
+/// `MultiAssetNotConserved` divergences (all `input_side:0`). The fix routes tags
+/// 0/1 through `decode_compact_value_exact`, recovering the `numMA` header and the
+/// `rep` `ShortByteString` length per the canonical Mary `Value.hs`
+/// `instance MemPack CompactValue` (`packTagM 1 >> packCompactCoinM c >>
+/// packM (VarLen numMA) >> packM rep`).
+///
+/// Targets (preprod Koios `asset_list` cross-checked):
+///   * 00000c0c…#0  → tag 0, numMA 10, policy f1efa1875f… NFT_90..NFT_99 (qty 1 ea)
+///   * 00000c0c…#1  → tag 0, numMA 10, policy f1efa1875f… NFT_480..NFT_489 (qty 1 ea)
+#[test]
+fn test_real_preprod_multi_asset_reconstruction() {
+    use super::compact::parse_multi_asset_rep;
+    use std::collections::BTreeMap;
+
+    let Ok(path) = std::env::var("DUGITE_PREPROD_TABLES") else {
+        eprintln!("skipping: set DUGITE_PREPROD_TABLES to a real tables/tvar blob");
+        return;
+    };
+    let data = std::fs::read(&path).expect("read tables blob");
+
+    let policy = "f1efa1875fc86249b86bdd726dc72f63ec94e15ba1b1285559bb1d25";
+    // (full_txid_hex, mempack_txix, expected sorted asset-name list, expected numMA).
+    let targets: &[(&str, u16, &[&str], u64)] = &[
+        (
+            "00000c0cf6fe6389492dd7fe7c8ff3040d70d11b3356093cf651ac876c6f66d9",
+            0,
+            &[
+                "NFT_90", "NFT_91", "NFT_92", "NFT_93", "NFT_94", "NFT_95", "NFT_96", "NFT_97",
+                "NFT_98", "NFT_99",
+            ],
+            10,
+        ),
+        (
+            "00000c0cf6fe6389492dd7fe7c8ff3040d70d11b3356093cf651ac876c6f66d9",
+            1,
+            &[
+                "NFT_480", "NFT_481", "NFT_482", "NFT_483", "NFT_484", "NFT_485", "NFT_486",
+                "NFT_487", "NFT_488", "NFT_489",
+            ],
+            10,
+        ),
+    ];
+    let mut matched = 0;
+    for entry in TvarIterator::new(&data).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        let txid_hex = hex::encode(txin.txid.as_bytes());
+        for (want_txid, want_ix, want_names, want_numma) in targets {
+            if &txid_hex != want_txid || txin.txix != *want_ix {
+                continue;
+            }
+            // ANTI-NO-OP: the bug left num_assets == 0 (rep dropped). The exact
+            // decoder must recover the real numMA from the CompactValue header.
+            assert_eq!(
+                txout.num_assets, *want_numma,
+                "numMA not recovered for {want_txid}#{want_ix} (the #10 bug: opaque path \
+                 left num_assets=0 and dropped every asset)"
+            );
+            let rep = txout
+                .multi_asset
+                .as_deref()
+                .expect("fixture UTxO must carry a multi-asset rep");
+            let triples = parse_multi_asset_rep(rep, txout.num_assets as usize)
+                .expect("rep must parse from the real blob");
+            assert!(
+                !triples.is_empty(),
+                "reconstructed multi_asset is EMPTY for {want_txid}#{want_ix} — \
+                 this is exactly the input_side:0 MultiAssetNotConserved symptom"
+            );
+            // Fold into a sorted (name -> qty) map and assert byte-exact equality
+            // with Koios's asset_list for this UTxO.
+            let policy_b = hex::decode(policy).unwrap();
+            let mut by_name: BTreeMap<String, u64> = BTreeMap::new();
+            for (pid, name, qty) in &triples {
+                assert_eq!(
+                    &pid[..],
+                    &policy_b[..],
+                    "all assets in {want_txid}#{want_ix} share the one policy"
+                );
+                *by_name
+                    .entry(String::from_utf8(name.clone()).unwrap())
+                    .or_default() += qty;
+            }
+            let got: Vec<String> = by_name.keys().cloned().collect();
+            let mut want: Vec<String> = want_names.iter().map(|s| s.to_string()).collect();
+            want.sort();
+            assert_eq!(
+                got, want,
+                "multi-asset reconstruction mismatch for {want_txid}#{want_ix}"
+            );
+            for n in *want_names {
+                assert_eq!(
+                    by_name.get(*n).copied(),
+                    Some(1),
+                    "quantity mismatch for {n} in {want_txid}#{want_ix}"
+                );
+            }
+            matched += 1;
+        }
+    }
+    assert_eq!(
+        matched,
+        targets.len(),
+        "all fixture multi-asset UTxOs must be found and verified"
+    );
+}
