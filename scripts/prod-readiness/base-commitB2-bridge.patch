+/// A clean definite-length map that is exhausted exactly at an entry boundary is
+/// a NORMAL end (`None`), not an error — this is the legitimate terminator the
+/// hard-error change must preserve.
+#[test]
+fn test_tvar_iterator_clean_end_is_not_an_error() {
+    // array(1) + map(indef) + one valid entry + break.
+    let entries = vec![([0x00u8, 0x01u8], ada_only_txout(5))];
+    let blob = build_tables_blob(&entries);
+    let results: Vec<_> = TvarIterator::new_with_endianness(&blob, TxIxEndianness::Big)
+        .unwrap()
+        .collect();
+    assert_eq!(results.len(), 1, "exactly one entry");
+    assert!(results[0].is_ok(), "the single valid entry must be Ok");
+}
+
+// ── #10 commit-B re-fix (R3): scientific c==0 short-circuit ───────────────────
+//
+// Mirrors `Data.Scientific.normalize`:
+//   normalize (Scientific c e) | … | otherwise {- c == 0 -} = Scientific 0 0
+// A zero coefficient forces the exponent to 0, so `toBoundedInteger` returns 0
+// without ever evaluating `10 ^ e`. We must return `Some(0)` for `0e<huge>`
+// rather than blowing up `BigInt::pow` or truncating `i64 -> u32`.
+
+#[test]
+fn test_scientific_zero_coefficient_huge_exponent_short_circuits_to_zero() {
+    // 0e2000000000: coeff 0, net_exp 2_000_000_000. Must be Some(0), fast.
+    assert_eq!(scientific_literal_as_word8("0e2000000000"), Some(0));
+    // An exponent that would overflow `i64 -> u32` if not short-circuited.
+    assert_eq!(scientific_literal_as_word8("0e9999999999"), Some(0));
+    // Negative-exponent and fractional zero spellings all reduce to 0.
+    assert_eq!(scientific_literal_as_word8("0e-2000000000"), Some(0));
+    assert_eq!(scientific_literal_as_word8("0.000"), Some(0));
+    assert_eq!(scientific_literal_as_word8("-0e500"), Some(0));
+    assert_eq!(scientific_literal_as_word8("0"), Some(0));
+}
+
+#[test]
+fn test_scientific_nonzero_still_parses_word8_range() {
+    // The c==0 short-circuit must not disturb the normal path.
+    assert_eq!(scientific_literal_as_word8("1"), Some(1));
+    assert_eq!(scientific_literal_as_word8("255"), Some(255));
+    assert_eq!(scientific_literal_as_word8("1e2"), Some(100));
+    assert_eq!(scientific_literal_as_word8("2.55e2"), Some(255));
+    // Out of Word8 range and non-integral remain None.
+    assert_eq!(scientific_literal_as_word8("256"), None);
+    assert_eq!(scientific_literal_as_word8("1.5"), None);
+}
