+    let mut found = vec![false; targets.len()];
+
+    let mut count_idx1 = 0u64;
+    let mut count_idx256 = 0u64;
+    let mut dist = TxIxDistribution::default();
+    for entry in TvarIterator::new_with_endianness(&data, endianness).unwrap() {
+        let Ok((txin, txout)) = entry else { continue };
+        observe_into(&mut dist, txin.txix);
+        if txin.txix == 1 {
+            count_idx1 += 1;
