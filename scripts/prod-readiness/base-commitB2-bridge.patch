+#[test]
+fn test_parse_tables_codec_version_integral_float_forms_accepted() {
+    // BYTE-EXACTNESS with Aeson (#10): `FromJSON Word8` decodes a JSON Number via
+    // `Scientific.toBoundedInteger`, which NORMALISES the Scientific first, so the
+    // float-SYNTAX integral forms `1.0`, `1e0`, `100e-2` all reduce to Word8 `1`
+    // and are ACCEPTED (then `enforceVersion 1 => TablesCodecVersion1 => Big`).
+    // dugite previously used `serde_json::Value::as_u64()`, which returns `None`
+    // for any float-typed JSON Number, OVER-STRICTly rejecting these. Fixed.
+    for form in [
+        &br#"{"backend":"utxohd-mem","tablesCodecVersion":1.0}"#[..],
+        &br#"{"backend":"utxohd-mem","tablesCodecVersion":1e0}"#[..],
+        &br#"{"backend":"utxohd-mem","tablesCodecVersion":100e-2}"#[..],
+    ] {
+        let v = parse_tables_codec_version(form)
+            .unwrap_or_else(|e| panic!("Aeson accepts integral float form, got Err: {e}"));
+        assert_eq!(v, 1, "integral float form must normalise to Word8 1");
+        assert_eq!(
+            TxIxEndianness::from_tables_codec_version(Some(v)).unwrap(),
+            TxIxEndianness::Big,
+            "version 1 (via float form) => big-endian"
+        );
+    }
+
+    // 0.0 is integral and in Word8 range => accepted as 0 by the parser, but
+    // `enforceVersion` rejects version 0 (only 1 is TablesCodecVersion1).
+    assert_eq!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":0.0}"#).unwrap(),
+        0
+    );
+    assert!(TxIxEndianness::from_tables_codec_version(Some(0)).is_err());
+
+    // 2.0 is integral/in-range => parser accepts as 2, but it is an UNKNOWN
+    // version => `enforceVersion`/`from_tables_codec_version` rejects it.
+    assert_eq!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":2.0}"#).unwrap(),
+        2
+    );
+    assert!(TxIxEndianness::from_tables_codec_version(Some(2)).is_err());
+}
