+    val.extend_from_slice(&[0x71; 29]);
+    // CompactValue multi-asset: tag(1) + VarLen(coin) + VarLen(numMA) + SBS(rep).
+    val.push(1);
+    val.extend_from_slice(&encode_varlen(777_000));
+    val.extend_from_slice(&encode_varlen(1)); // numMA
+    val.extend_from_slice(&mempack_sbs(&rep));
+    // BinaryData inline datum.
+    val.extend_from_slice(&mempack_sbs(&datum_cbor));
+
+    let (txout, consumed) = decode_mempack_txout(&val).unwrap();
+    assert_eq!(
+        consumed,
+        val.len(),
+        "tag-4 multi-asset must consume the blob"
+    );
+    assert_eq!(txout.tag, 4);
+    assert_eq!(txout.coin, 777_000);
+    assert_eq!(txout.multi_asset.as_deref(), Some(&rep[..]));
+    assert!(txout.datum_hash.is_none());
+    assert_eq!(
+        txout.datum.as_deref(),
+        Some(&datum_cbor[..]),
+        "multi-asset tag-4 inline datum recovered byte-exact"
+    );
+}
