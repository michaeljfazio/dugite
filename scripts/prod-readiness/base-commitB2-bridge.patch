+#[test]
+fn test_parse_tables_codec_version_sub_ulp_fractional_rejected() {
+    // R3 BYTE-EXACTNESS (#10): `1.0000000000000001` is a SUB-ULP fractional whose
+    // nearest f64 is exactly `1.0`. `serde_json` here is built WITHOUT
+    // `arbitrary_precision`, so an f64-based integral test (`f.fract() == 0.0`)
+    // WRONGLY ACCEPTS it as `1`. Aeson's `FromJSON Word8` runs
+    // `Scientific.toBoundedInteger`, whose `integral = e >= 0 || e' >= 0` test sees
+    // the 16-digit fractional part (net exponent `-16`, coefficient not divisible by
+    // 10^16) ⇒ NON-integral ⇒ `Nothing` ⇒ REJECT. dugite must reject too. This is the
+    // exact case the raw-literal scan exists for.
+    assert!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":1.0000000000000001}"#).is_err(),
+        "sub-ULP fractional must be rejected byte-exactly with Aeson (toBoundedInteger Nothing)"
+    );
+    // A few more sub-ULP / many-fractional-digit forms that round to an integer f64
+    // but are genuinely non-integral as exact decimals => all REJECT.
+    assert!(parse_tables_codec_version(br#"{"tablesCodecVersion":0.9999999999999999}"#).is_err());
+    assert!(parse_tables_codec_version(br#"{"tablesCodecVersion":2.0000000000000001}"#).is_err());
+    // Trailing-zero fractional that IS integral after cancellation => still accepted
+    // (e.g. 1.00000000000000000 == 1). Guards against over-rejecting.
+    assert_eq!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":1.00000000000000000}"#).unwrap(),
+        1
+    );
+    // Scientific form with large negative exponent that re-integralises => accepted.
+    // 10000000000000000e-16 == 1.
+    assert_eq!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":10000000000000000e-16}"#).unwrap(),
+        1
+    );
+    // Same magnitude but the last digit makes it non-integral => REJECT.
+    assert!(
+        parse_tables_codec_version(br#"{"tablesCodecVersion":10000000000000001e-16}"#).is_err()
+    );
+}
