+#[test]
+fn test_txix_distribution_safety_net_trips_on_miskey() {
+    // A deliberately mis-keyed sample: BE-written `00 01` entries read as LE all
+    // become 256, producing a distribution that is NOT sane.
+    let entries: Vec<_> = (0..40)
+        .map(|_| ([0x00u8, 0x01u8], ada_only_txout(3)))
+        .collect();
+    let blob = build_tables_blob(&entries);
+
+    // Iterate with the WRONG (LE) endianness explicitly, collect the distribution.
+    let mut dist = TxIxDistribution::default();
+    for entry in TvarIterator::new_with_endianness(&blob, TxIxEndianness::Little).unwrap() {
+        let (txin, _) = entry.unwrap();
+        assert_eq!(txin.txix, 256, "LE-misread BE `00 01` => 256");
+        observe_into(&mut dist, txin.txix);
+    }
+    // The safety net MUST trip (refuse the import) on this mis-keyed sample.
+    assert!(
+        assert_txix_distribution_sane(&dist, TxIxEndianness::Little).is_err(),
+        "safety net must reject a mis-keyed (all-256) distribution"
+    );
+
+    // And the correct (BE) read yields a sane distribution the safety net accepts.
+    let mut good = TxIxDistribution::default();
+    for entry in TvarIterator::new_with_endianness(&blob, TxIxEndianness::Big).unwrap() {
+        let (txin, _) = entry.unwrap();
+        observe_into(&mut good, txin.txix);
+    }
+    assert!(assert_txix_distribution_sane(&good, TxIxEndianness::Big).is_ok());
+}
