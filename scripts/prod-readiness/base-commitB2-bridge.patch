+    // "utxohd-mem", tablesCodecVersion=1 => Big). The meta is MANDATORY — there
+    // is no empirical-detector fallback in the production import path.
+    let meta = std::fs::read(&meta_path)
+        .expect("real preprod snapshot must have a meta file (strict: no meta-less import path)");
