+// ── #10 commit-B re-fix: TvarIterator HARD-ERRORs on truncation ───────────────
+//
+// Haskell `loadSnapshot` (ouroboros-consensus `…/LedgerDB/V2/InMemory.hs`) aborts
+// the whole import on any `readIncremental … valuesMKDecoder` failure
+// (`InitFailureRead . ReadSnapshotFailed`) — a CBOR `Fail`, partial-EOF, or
+// leftover bytes. Mid-stream truncation must therefore yield `Some(Err(..))`, NOT
+// a silent `None`/partial UTxO set. A clean stream end (indefinite break `0xff`
+// or definite-map exhaustion exactly at an entry boundary) stays `None`.
+
+/// One valid BE entry, then a SECOND entry whose CBOR key header (`0x58 0x22` =
+/// bytes(34)) is present but truncated to < 34 bytes — a partial entry. The
+/// iterator must yield the first entry, then HARD-ERROR on the truncated second.
+#[test]
+fn test_tvar_iterator_truncated_entry_key_hard_errors() {
+    // Start from a known-good single-entry blob (built exactly like the importer
+    // expects), then append a truncated SECOND entry: its bytes(34) key header is
+    // announced but only 10 of 34 key bytes are present.
+    let valid = build_tables_blob(&[([0x00u8, 0x01u8], ada_only_txout(7))]);
+    let mut blob = valid[..valid.len() - 1].to_vec(); // strip the trailing 0xff break
+    blob.push(0x58);
+    blob.push(34);
+    blob.extend_from_slice(&[0u8; 10]);
+    // NO 0xff break — this is a genuine truncation, not a clean end.
+
+    let mut iter = TvarIterator::new_with_endianness(&blob, TxIxEndianness::Big).unwrap();
+    let first = iter.next().expect("first entry present");
+    assert!(first.is_ok(), "first valid entry must decode");
+    let second = iter.next().expect("must yield an error item, not None");
+    assert!(
+        second.is_err(),
+        "truncated entry key must HARD-ERROR (Haskell loadSnapshot aborts on partial-EOF), \
+         not silently finish"
+    );
+}
+
+/// A key decodes but there are no bytes left for its value (truncated mid-pair).
+/// Must HARD-ERROR, never import a key with no value.
+#[test]
+fn test_tvar_iterator_missing_value_hard_errors() {
+    let mut blob = vec![0x81u8, 0xbf];
+    blob.push(0x58);
+    blob.push(34);
+    let mut key = [0u8; 34];
+    key[0] = 1;
+    blob.extend_from_slice(&key);
+    // No value bytes follow, and no 0xff break: the pair is truncated after the key.
+
+    let mut iter = TvarIterator::new_with_endianness(&blob, TxIxEndianness::Big).unwrap();
+    let item = iter.next().expect("must yield an error item, not None");
+    assert!(
+        item.is_err(),
+        "key present but value missing must HARD-ERROR (partial-EOF), not silently finish"
+    );
+}
+
+/// The value's CBOR header is present but its declared length runs past the blob
+/// (truncated/malformed value). Must HARD-ERROR.
+#[test]
+fn test_tvar_iterator_truncated_value_hard_errors() {
+    let mut blob = vec![0x81u8, 0xbf];
+    blob.push(0x58);
+    blob.push(34);
+    let mut key = [0u8; 34];
+    key[0] = 1;
+    blob.extend_from_slice(&key);
+    // Value header bytes(10) but only 3 bytes follow.
+    blob.push(0x4a); // bytes(10)
+    blob.extend_from_slice(&[0u8; 3]);
+
+    let mut iter = TvarIterator::new_with_endianness(&blob, TxIxEndianness::Big).unwrap();
+    let item = iter.next().expect("must yield an error item, not None");
+    assert!(
+        item.is_err(),
+        "truncated value must HARD-ERROR (CBOR Fail), not silently finish"
+    );
+}
